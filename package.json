{
  "name": "pi-herdsman",
  "version": "0.28.0",
  "type": "module",
  "description": "Asynchronous Pi subagents and agent fleet orchestration for parallel coding agents with nested delegation, background work, and supervision in herdr.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boadij/pi-herdsman.git"
  },
  "bugs": {
    "url": "https://github.com/boadij/pi-herdsman/issues"
  },
  "homepage": "https://github.com/boadij/pi-herdsman#readme",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "subagent",
    "subagents",
    "agents",
    "ai-agents",
    "coding-agents",
    "coding-agent-orchestration",
    "multi-agent",
    "multi-agent-coding",
    "agent-fleet",
    "parallel-agents",
    "parallel-coding-agents",
    "background-agents",
    "nested-agents",
    "agent-orchestration",
    "orchestration",
    "delegation",
    "supervision",
    "herdr",
    "pi-herdsman"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ],
    "skills": [
      "./SKILL.md",
      "./skills"
    ],
    "image": "https://raw.githubusercontent.com/boadij/pi-herdsman/main/docs/assets/thumbnail.webp"
  },
  "piHerdsman": {
    "runtime": {
      "pi": "1.3.0",
      "herdr": {
        "version": "0.9.5",
        "sha256": {
          "linux-x86_64": "14d9e8bc8b4a9e0118d77c32266f76d461f09b40342eb23752960bd89f59929d",
          "linux-aarch64": "17d7536f2da50859523680ef279dffcac8e4a235f4e46fe8da6c2ec44141897c",
          "macos-x86_64": "5fb0a908ec7f6745e3e245738b06bfad56c46391c391ab3c0955fbead01f1369",
          "macos-aarch64": "fb77c2232a05a8035421382c894392f4174e4e38a18e48af3dd0290157c3a7e2"
        }
      }
    }
  },
  "scripts": {
    "test": "node --experimental-test-module-mocks --import=./scripts/test-env.mjs --test --test-timeout=10000",
    "smoke": "node scripts/smoke.mjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "node scripts/check.mjs",
    "build": "node scripts/build.mjs",
    "package:audit": "node scripts/package-audit.mjs",
    "validate": "npm run format:check && npm run check && npm run build && npm run package:audit",
    "release:check": "npm run validate && npm publish --dry-run --ignore-scripts",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@howaboua/pi-codex-conversion": "^3.0.45",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@howaboua/pi-codex-conversion": "3.0.45",
    "esbuild": "^0.28.2",
    "prettier": "3.9.10",
    "typebox": "^1.3.7"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "README.md",
    "SKILL.md",
    "LICENSE",
    "docs",
    "dist",
    "skills"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependenciesMeta": {
    "@howaboua/pi-codex-conversion": {
      "optional": true
    }
  }
}
