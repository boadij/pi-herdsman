{
  "name": "pi-herdsman",
  "version": "0.21.3",
  "type": "module",
  "description": "Asynchronous Pi subagents and agent fleet orchestration for parallel coding agents with nested delegation, background work, and supervision in herdr.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boadij/pi-herdsman.git"
  },
  "bugs": {
    "url": "https://github.com/boadij/pi-herdsman/issues"
  },
  "homepage": "https://github.com/boadij/pi-herdsman#readme",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "subagent",
    "subagents",
    "agents",
    "ai-agents",
    "coding-agents",
    "coding-agent-orchestration",
    "multi-agent",
    "multi-agent-coding",
    "agent-fleet",
    "parallel-agents",
    "parallel-coding-agents",
    "background-agents",
    "nested-agents",
    "agent-orchestration",
    "orchestration",
    "delegation",
    "supervision",
    "herdr",
    "pi-herdsman"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ],
    "skills": [
      "./SKILL.md",
      "./skills"
    ],
    "image": "https://raw.githubusercontent.com/boadij/pi-herdsman/main/docs/assets/thumbnail.webp"
  },
  "piHerdsman": {
    "runtime": {
      "pi": "1.1.0",
      "herdr": {
        "version": "0.9.3",
        "sha256": {
          "linux-x86_64": "18a8dc65f1c2fa485884344356dea1cfd911c6f06cf46fa78e193f4087f4dba7",
          "linux-aarch64": "4de7aa3e25678812e92960de64f7c2aaa1bca1f0f80a3c5e559837e231e1f5c0",
          "macos-x86_64": "db62d548ff3e832b087a96b1894a08d26be3905f1830309cd556783f215d4054",
          "macos-aarch64": "5173a3e0ae42d5d1ab7ebfa5d5e6329f7c3d23f8e1a3677c7ce3231da2884157"
        }
      }
    }
  },
  "scripts": {
    "test": "node --experimental-test-module-mocks --import=./scripts/test-env.mjs --test --test-timeout=10000",
    "smoke": "node scripts/smoke.mjs",
    "check": "node scripts/check.mjs",
    "build": "node scripts/build.mjs",
    "package:audit": "node scripts/package-audit.mjs",
    "validate": "npm run check && npm run build && npm run package:audit",
    "release:check": "npm run validate && npm publish --dry-run --ignore-scripts",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "esbuild": "^0.28.2",
    "typebox": "^1.3.7"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "README.md",
    "SKILL.md",
    "LICENSE",
    "docs",
    "dist",
    "skills"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  }
