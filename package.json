{
  "name": "pi-herdsman",
  "version": "0.4.0",
  "type": "module",
  "description": "Asynchronous Pi agent orchestration with nested delegation, parallel execution, and supervision in herdr.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boadij/pi-herdsman.git"
  },
  "bugs": {
    "url": "https://github.com/boadij/pi-herdsman/issues"
  },
  "homepage": "https://github.com/boadij/pi-herdsman#readme",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "subagent",
    "subagents",
    "agents",
    "ai-agents",
    "coding-agents",
    "multi-agent",
    "multi-agent-coding",
    "agent-orchestration",
    "orchestration",
    "delegation",
    "supervision",
    "herdr",
    "pi-herdsman"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ],
    "skills": [
      "."
    ],
    "image": "https://raw.githubusercontent.com/boadij/pi-herdsman/main/docs/assets/thumbnail.webp"
  },
  "scripts": {
    "test": "node --experimental-test-module-mocks --test --test-timeout=10000",
    "check": "node scripts/check.mjs",
    "build": "node scripts/build.mjs",
    "package:audit": "node scripts/package-audit.mjs",
    "validate": "npm run check && npm run build && npm run package:audit",
    "release:check": "npm run validate && npm publish --dry-run --ignore-scripts",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.84.2 <0.86.0",
    "@earendil-works/pi-coding-agent": ">=0.84.2 <0.86.0",
    "@earendil-works/pi-tui": ">=0.84.2 <0.86.0",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.2",
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@earendil-works/pi-tui": "^0.84.2",
    "esbuild": "^0.28.2",
    "typebox": "^1.3.7"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "README.md",
    "SKILL.md",
    "LICENSE",
    "docs",
    "dist"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  }
}
